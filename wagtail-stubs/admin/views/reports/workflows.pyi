from typing import Any

from django.contrib.auth.models import AbstractBaseUser
from django.db.models import Model, QuerySet
from django.http import HttpRequest
from django.utils.functional import cached_property
from wagtail.admin.filters import FilteredModelChoiceFilter, WagtailFilterSet
from wagtail.admin.widgets.button import Button
from wagtail.models import AbstractPage
from wagtail.models.workflows import TaskState, WorkflowState
from wagtail.permission_policies.pages import PagePermissionPolicy
import django_filters

from .base import ReportView

Page: type[AbstractPage]

def get_requested_by_queryset(request: HttpRequest) -> QuerySet[AbstractBaseUser]: ...
def get_editable_page_ids_query(request: HttpRequest) -> QuerySet[AbstractPage, str]: ...
def get_editable_content_type_ids(request: HttpRequest) -> list[int]: ...

class WorkflowReportFilterSet(WagtailFilterSet):
    created_at: django_filters.DateFromToRangeFilter
    reviewable: django_filters.ChoiceFilter
    requested_by: django_filters.ModelChoiceFilter
    def filter_reviewable(
        self, queryset: QuerySet[WorkflowState], name: str, value: str
    ) -> QuerySet[WorkflowState]: ...

class WorkflowTasksReportFilterSet(WagtailFilterSet):
    started_at: django_filters.DateFromToRangeFilter
    finished_at: django_filters.DateFromToRangeFilter
    workflow: django_filters.ModelChoiceFilter
    task: FilteredModelChoiceFilter
    reviewable: django_filters.ChoiceFilter
    def filter_reviewable(self, queryset: QuerySet[TaskState], name: str, value: str) -> QuerySet[TaskState]: ...

class WorkflowView(ReportView):
    filterset_class: type[WorkflowReportFilterSet]
    any_permission_required: list[str]
    @cached_property
    def permission_policy(self) -> PagePermissionPolicy[AbstractPage]: ...
    def __init__(self, **kwargs: Any) -> None: ...
    @cached_property
    def header_buttons(self) -> list[Button]: ...
    def get_title(self, content_object: Model) -> str: ...
    def get_filename(self) -> str: ...
    def get_queryset(self) -> QuerySet[WorkflowState]: ...
    def decorate_paginated_queryset(self, object_list: Any) -> list[WorkflowState]: ...

class WorkflowTasksView(ReportView):
    filterset_class: type[WorkflowTasksReportFilterSet]
    any_permission_required: list[str]
    @cached_property
    def permission_policy(self) -> PagePermissionPolicy[AbstractPage]: ...
    def __init__(self, **kwargs: Any) -> None: ...
    @cached_property
    def header_buttons(self) -> list[Button]: ...
    def get_title(self, content_object: Model) -> str: ...
    def get_filename(self) -> str: ...
    def get_queryset(self) -> QuerySet[TaskState]: ...
    def decorate_paginated_queryset(self, object_list: Any) -> list[TaskState]: ...
