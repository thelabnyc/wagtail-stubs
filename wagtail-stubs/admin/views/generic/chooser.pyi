from collections.abc import Iterable
from typing import Any, Generic

from django.core.paginator import Page
from django.db import models
from django.forms import Form
from django.http import HttpRequest, HttpResponse, JsonResponse
from django.utils.functional import _StrOrPromise, cached_property
from django.views.generic.base import ContextMixin, View
from typing_extensions import TypeVar
from wagtail.admin.forms.choosers import BaseFilterForm
from wagtail.admin.paginator import WagtailPaginator
from wagtail.admin.ui.tables import Column, Table, TitleColumn
from wagtail.permission_policies import BasePermissionPolicy

_ModelT = TypeVar("_ModelT", bound=models.Model, default=models.Model)

class ModalPageFurnitureMixin(ContextMixin):
    icon: str | None
    page_title: _StrOrPromise | None
    page_subtitle: _StrOrPromise | None
    def get_context_data(self, **kwargs: Any) -> dict[str, Any]: ...

class ModelLookupMixin(Generic[_ModelT]):
    model: type[_ModelT] | str | None
    @cached_property
    def model_class(self) -> type[_ModelT] | None: ...

class PreserveURLParametersMixin:
    preserve_url_parameters: list[str]
    @cached_property
    def _preserved_param_string(self) -> str: ...
    def append_preserved_url_parameters(self, url: str) -> str: ...

class CheckboxSelectColumn(Column):
    cell_template_name: str

class BaseChooseView(
    ModalPageFurnitureMixin,
    ModelLookupMixin[_ModelT],
    PreserveURLParametersMixin,
    ContextMixin,
    View,
):
    per_page: int
    ordering: str | list[str] | tuple[str, ...] | None
    chosen_url_name: str | None
    chosen_multiple_url_name: str | None
    results_url_name: str | None
    icon: str
    page_title: _StrOrPromise
    filter_form_class: type[Form] | None
    template_name: str
    results_template_name: str
    construct_queryset_hook_name: str | None
    url_filter_parameters: list[str]
    paginator_class: type[WagtailPaginator]
    filter_form: BaseFilterForm
    results: Page[_ModelT]
    paginator: WagtailPaginator
    table: Table
    @cached_property
    def i18n_enabled(self) -> bool: ...
    def get_object_list(self) -> models.QuerySet[_ModelT]: ...
    def apply_object_list_ordering(self, objects: models.QuerySet[_ModelT]) -> models.QuerySet[_ModelT]: ...
    def get_filter_form_class(self) -> type[BaseFilterForm]: ...
    def get_filter_form(self) -> BaseFilterForm: ...
    def filter_object_list(self, objects: models.QuerySet[_ModelT]) -> models.QuerySet[_ModelT]: ...
    def get_results_url(self) -> str: ...
    def get_chosen_multiple_url(self) -> str: ...
    @cached_property
    def is_multiple_choice(self) -> str | None: ...
    @property
    def columns(self) -> list[Column]: ...
    @property
    def title_column(self) -> TitleColumn: ...
    @property
    def checkbox_column(self) -> CheckboxSelectColumn: ...
    def get_results_page(self, request: HttpRequest) -> Page[_ModelT]: ...
    def get(self, request: HttpRequest) -> HttpResponse: ...
    def get_context_data(self, **kwargs: Any) -> dict[str, Any]: ...
    def render_to_response(self) -> HttpResponse: ...

class CreationFormMixin(ModelLookupMixin[_ModelT], PreserveURLParametersMixin, Generic[_ModelT]):
    creation_form_class: type[Form] | None
    form_fields: list[str] | None
    exclude_form_fields: list[str] | None
    creation_form_template_name: str
    creation_tab_id: str
    create_action_label: _StrOrPromise
    create_action_clicked_label: _StrOrPromise | None
    create_url_name: str | None
    @cached_property
    def permission_policy(self) -> BasePermissionPolicy[Any] | None: ...
    def get_permission_policy(self) -> BasePermissionPolicy[Any]: ...
    def can_create(self) -> bool: ...
    def get_creation_form_class(self) -> type[Form] | None: ...
    def get_creation_form_kwargs(self) -> dict[str, Any]: ...
    def get_creation_form(self) -> Form | None: ...
    def get_create_url(self) -> str: ...
    def get_creation_form_context_data(self, form: Form) -> dict[str, Any]: ...

class ChooseViewMixin:
    search_tab_label: _StrOrPromise
    creation_tab_label: _StrOrPromise | None
    def get_context_data(self, **kwargs: Any) -> dict[str, Any]: ...
    def get_response_json_data(self) -> dict[str, Any]: ...
    def render_to_response(self) -> JsonResponse: ...

class ChooseView(ChooseViewMixin, CreationFormMixin[_ModelT], BaseChooseView[_ModelT]): ...

class ChooseResultsViewMixin:
    def render_to_response(self) -> HttpResponse: ...

class ChooseResultsView(ChooseResultsViewMixin, CreationFormMixin[_ModelT], BaseChooseView[_ModelT]): ...

class ChosenResponseMixin(Generic[_ModelT]):
    response_data_title_key: str
    chosen_response_name: str
    def get_object_id(self, instance: _ModelT) -> Any: ...
    def get_display_title(self, instance: _ModelT) -> str: ...
    def get_edit_item_url(self, instance: _ModelT) -> str | None: ...
    def get_chosen_response_data(self, item: _ModelT) -> dict[str, Any]: ...
    def _wrap_chosen_response_data(self, response_data: dict[str, Any] | list[dict[str, Any]]) -> JsonResponse: ...
    def get_multiple_chosen_response(self, items: Iterable[_ModelT]) -> JsonResponse: ...
    def get_chosen_response(self, item: _ModelT) -> JsonResponse: ...

class ChosenViewMixin(ModelLookupMixin[_ModelT]):
    def get_object(self, pk: str) -> _ModelT: ...
    def get(self, request: HttpRequest, pk: str) -> JsonResponse: ...

class ChosenView(ChosenViewMixin[_ModelT], ChosenResponseMixin[_ModelT], View): ...

class ChosenMultipleViewMixin(ModelLookupMixin[_ModelT]):
    def get_objects(self, pks: list[str]) -> models.QuerySet[_ModelT]: ...
    def get(self, request: HttpRequest) -> JsonResponse: ...

class ChosenMultipleView(ChosenMultipleViewMixin[_ModelT], ChosenResponseMixin[_ModelT], View): ...

class CreateViewMixin(Generic[_ModelT]):
    model: type[_ModelT] | str | None
    form: Form
    def dispatch(self, request: HttpRequest, *args: Any, **kwargs: Any) -> HttpResponse: ...
    def get(self, request: HttpRequest) -> JsonResponse: ...
    def save_form(self, form: Form) -> _ModelT: ...
    def post(self, request: HttpRequest) -> JsonResponse: ...
    def get_reshow_creation_form_response(self) -> JsonResponse: ...

class CreateView(CreateViewMixin[_ModelT], CreationFormMixin[_ModelT], ChosenResponseMixin[_ModelT], View): ...
