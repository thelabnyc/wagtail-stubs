from typing import Any, Generic

from django.db import models
from django.forms import BaseForm, BaseModelForm, Form
from django.http import HttpRequest, HttpResponse, JsonResponse
from django.utils.functional import cached_property
from typing_extensions import TypeVar
from wagtail.admin.forms.models import WagtailAdminModelForm
from wagtail.admin.panels import Panel
from wagtail.admin.ui.editing_sessions import EditingSessionsModule
from wagtail.admin.ui.tables import Column
from wagtail.locks import BaseLock
from wagtail.models.i18n import Locale
from wagtail.models.revisions import Revision
from wagtail.models.workflows import Task, Workflow, WorkflowState

_ModelT = TypeVar("_ModelT", bound=models.Model, default=models.Model)
_FormT = TypeVar("_FormT", bound=BaseForm, default=Any)
_ModelFormT = TypeVar("_ModelFormT", bound=BaseModelForm[Any], default=WagtailAdminModelForm)
_HookFormT = TypeVar("_HookFormT", bound=BaseForm, default=Form)

class HookResponseMixin:
    def run_hook(self, hook_name: str, *args: Any, **kwargs: Any) -> HttpResponse | None: ...

class BeforeAfterHookMixin(HookResponseMixin, Generic[_HookFormT]):
    def run_before_hook(self) -> HttpResponse | None: ...
    def run_after_hook(self) -> HttpResponse | None: ...
    def dispatch(self, *args: Any, **kwargs: Any) -> HttpResponse: ...
    def form_valid(self, form: _HookFormT) -> HttpResponse: ...

class LocaleMixin:
    @cached_property
    def i18n_enabled(self) -> bool: ...
    @cached_property
    def locale(self) -> Locale | None: ...
    @cached_property
    def translations(self) -> list[dict[str, Any]]: ...
    def get_locale(self) -> Locale | None: ...
    def get_translations(self) -> list[dict[str, Any]]: ...
    def get_context_data(self, **kwargs: Any) -> dict[str, Any]: ...
    def _set_locale_query_param(self, url: str, locale: Locale | None = ...) -> str: ...

class PanelMixin(Generic[_FormT]):
    panel: Panel | None
    def setup(self, request: HttpRequest, *args: Any, **kwargs: Any) -> None: ...
    def get_panel(self) -> Panel | None: ...
    def get_bound_panel(self, form: _FormT) -> Panel.BoundPanel | None: ...
    def get_form_class(self) -> type[_FormT]: ...
    def get_context_data(self, **kwargs: Any) -> dict[str, Any]: ...

class IndexViewOptionalFeaturesMixin(Generic[_ModelT]):
    def _get_title_column(
        self,
        field_name: str,
        column_class: type[Column] = ...,
        **kwargs: Any,
    ) -> Column: ...
    def _annotate_queryset_updated_at(self, queryset: models.QuerySet[_ModelT]) -> models.QuerySet[_ModelT]: ...
    @cached_property
    def list_display(self) -> list[str | Column]: ...

class CreateEditViewOptionalFeaturesMixin(Generic[_ModelT, _ModelFormT]):
    view_name: str
    preview_url_name: str | None
    lock_url_name: str | None
    unlock_url_name: str | None
    revisions_unschedule_url_name: str | None
    revisions_compare_url_name: str | None
    workflow_history_url_name: str | None
    confirm_workflow_cancellation_url_name: str | None
    preview_enabled: bool
    revision_enabled: bool
    draftstate_enabled: bool
    locking_enabled: bool
    autosave_interval: int
    autosave_enabled: bool
    object: _ModelT | None
    lock: BaseLock | None
    locked_for_user: bool
    saving_as_draft: bool
    live_object: _ModelT
    form: _ModelFormT
    new_revision: Revision | None
    workflow_action: str | None
    produced_error_code: str
    produced_error_message: str | None
    def setup(self, request: HttpRequest, *args: Any, **kwargs: Any) -> None: ...
    @cached_property
    def workflow(self) -> Workflow | None: ...
    @cached_property
    def workflow_enabled(self) -> bool: ...
    @cached_property
    def workflow_state(self) -> WorkflowState | None: ...
    @cached_property
    def current_workflow_task(self) -> Task | None: ...
    @cached_property
    def workflow_tasks(self) -> list[Task]: ...
    @cached_property
    def latest_revision(self) -> Revision | None: ...
    @cached_property
    def latest_revision_created_at(self) -> str | None: ...
    @cached_property
    def is_out_of_date(self) -> bool: ...
    def user_has_permission(self, permission: str) -> bool: ...
    def workflow_action_is_valid(self) -> bool: ...
    def get_available_actions(self) -> list[str]: ...
    def get_object(self, queryset: models.QuerySet[_ModelT] | None = ...) -> _ModelT | None: ...
    def get_lock(self) -> BaseLock | None: ...
    def get_lock_url(self) -> str | None: ...
    def get_unlock_url(self) -> str | None: ...
    def get_preview_url(self) -> str | None: ...
    def get_workflow_history_url(self) -> str | None: ...
    def get_confirm_workflow_cancellation_url(self) -> str | None: ...
    def get_success_message(self, instance: _ModelT | None = ...) -> str: ...
    def get_success_url(self) -> str: ...
    def save_instance(self) -> _ModelT: ...
    def get_success_json(self) -> dict[str, Any]: ...
    @cached_property
    def overwrite_revision(self) -> Revision | None: ...
    def publish_action(self) -> HttpResponse | None: ...
    def submit_action(self) -> None: ...
    def restart_workflow_action(self) -> None: ...
    def cancel_workflow_action(self) -> None: ...
    def workflow_action_action(self) -> None: ...
    def run_action_method(self) -> HttpResponse | None: ...
    def is_valid(self, form: _ModelFormT) -> bool: ...
    def form_valid(self, form: _ModelFormT) -> HttpResponse: ...
    def form_invalid(self, form: _ModelFormT) -> HttpResponse: ...
    def get_last_updated_info(self) -> dict[str, Any] | None: ...
    def get_lock_context(self) -> dict[str, Any]: ...
    def get_editing_sessions(self) -> EditingSessionsModule | None: ...
    def get_context_data(self, **kwargs: Any) -> dict[str, Any]: ...

class RevisionsRevertMixin(Generic[_ModelT]):
    revision_id_kwarg: str
    revisions_revert_url_name: str | None
    revision_id: str | None
    revision: Revision
    has_content_changes: bool
    new_revision: Revision | None
    def setup(self, request: HttpRequest, *args: Any, **kwargs: Any) -> None: ...
    def get(self, request: HttpRequest, *args: Any, **kwargs: Any) -> HttpResponse: ...
    def get_revisions_revert_url(self) -> str: ...
    def get_warning_message(self) -> str: ...
    def _add_warning_message(self) -> None: ...
    def get_object(self, queryset: models.QuerySet[_ModelT] | None = ...) -> _ModelT: ...
    def save_instance(self) -> _ModelT: ...
    def get_success_message(self) -> str: ...
    def get_context_data(self, **kwargs: Any) -> dict[str, Any]: ...

class JsonPostResponseMixin:
    partials_template_name: str | None
    @cached_property
    def expects_json_response(self) -> bool: ...
    def json_error_response(self, error_code: str, error_message: str) -> JsonResponse: ...
    @staticmethod
    def response_is_json(response: HttpResponse) -> bool: ...
    def render_partials(self) -> str: ...
