from typing import Any, Self

from django.db.models import Model
from django.utils.functional import cached_property
from pydantic import BaseModel, TypeAdapter
from wagtail.models import Site

class APIFieldValidator(BaseModel):
    model: type[Model]
    fields: list[str]
    base_fields: list[str] = ...
    db_fields_only: bool = ...
    skip_invalid: bool = ...
    @cached_property
    def allowed_fields(self) -> set[str]: ...
    @cached_property
    def valid_fields(self) -> list[str]: ...
    @cached_property
    def invalid_fields(self) -> list[str]: ...
    def validate_fields(self) -> Self: ...

class OrderingValidator(APIFieldValidator):
    has_offset: bool = ...
    @cached_property
    def allowed_fields(self) -> set[str]: ...
    def validate_random(self) -> Self: ...

class SiteFilterValidator(BaseModel):
    site: str | None = ...
    request: Any
    @cached_property
    def query(self) -> dict[str, str] | None: ...
    @cached_property
    def site_obj(self) -> Site | None: ...

bool_adapter: TypeAdapter[bool]
