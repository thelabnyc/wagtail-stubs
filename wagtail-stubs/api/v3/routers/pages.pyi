from typing import Any, Literal, Self, TypeAlias
import builtins

from django.db.models import Model, Q
from django.http import HttpRequest, HttpResponseRedirect
from ninja import FilterSchema, Router, Schema, Status
from ninja.params.models import Body as _BodyParam
from ninja.params.models import Query as _QueryParam
from pydantic import BaseModel
from wagtail.api.rich_text import RichTextOutputFormat
from wagtail.api.v3.schemas.params import OrderingSchema, RevisionFilterSchema, SearchSchema
from wagtail.api.v3.schemas.revisions import RevisionDetailSchema
from wagtail.models import AbstractPage, Revision
from wagtail.query import PageQuerySet

Page: type[AbstractPage]
router: Router
actions_router: Router
page_models: list[type[AbstractPage]]
PageTypeLiteral: TypeAlias = str  # NOQA:UP040
PageDetailSchema: object
PageCreateSchema: object
PageUpdateSchema: object

class PageRevisionDetailSchema(RevisionDetailSchema):
    content_object: object

IntPKFilter: TypeAlias = int  # NOQA:UP040
RootRelativeFilter: TypeAlias = int | Literal["root"]  # NOQA:UP040

def custom_filter(self: Any, value: Any) -> Q: ...

class PageFilterSchema(FilterSchema):
    type: list[PageTypeLiteral] = ...
    ancestor_of: IntPKFilter | None = ...
    child_of: RootRelativeFilter | None = ...
    descendant_of: RootRelativeFilter | None = ...
    translation_of: RootRelativeFilter | None = ...
    locale: str | None = ...
    site: str | None = ...
    @classmethod
    def parse_type(cls, value: list[PageTypeLiteral]) -> list[builtins.type[Model]]: ...
    def filter_type(self, value: list[builtins.type[Model]]) -> Q: ...
    def filter_locale(self, value: str) -> Q: ...
    def validate_child_of_or_descendant_of(self) -> Self: ...
    def filter_ancestor_of(self, value: Any) -> Q: ...
    def filter_child_of(self, value: Any) -> Q: ...
    def filter_descendant_of(self, value: Any) -> Q: ...
    def filter_translation_of(self, value: Any) -> Q: ...
    def filter_site(self, value: Any) -> Q: ...
    @staticmethod
    def get_request_root_page(request: HttpRequest) -> AbstractPage: ...
    @staticmethod
    def get_public_page(request: HttpRequest, page_id: int, loc: str) -> AbstractPage: ...
    @staticmethod
    def get_public_page_or_root(request: HttpRequest, page_id: RootRelativeFilter, loc: str) -> AbstractPage: ...
    def apply_ancestor_of[QS: PageQuerySet[Any]](self, request: HttpRequest, queryset: QS) -> QS: ...
    def apply_descendant_of[QS: PageQuerySet[Any]](self, request: HttpRequest, queryset: QS) -> QS: ...
    def apply_translation_of[QS: PageQuerySet[Any]](self, request: HttpRequest, queryset: QS) -> QS: ...
    def apply_custom_filters[QS: PageQuerySet[Any]](self, request: HttpRequest, queryset: QS) -> QS: ...
    def filter[QS: PageQuerySet[Any]](self, queryset: QS, request: HttpRequest | None = None) -> QS: ...  # type: ignore[override]

def list_pages(
    request: HttpRequest,
    filters: PageFilterSchema | _QueryParam = ...,
    ordering: OrderingSchema | _QueryParam = ...,
    search: SearchSchema | _QueryParam = ...,
    **kwargs: Any,
) -> dict[str, Any]: ...
def find_page(
    request: HttpRequest,
    id: int | None = None,
    html_path: str | None = None,
    site: str | None = None,
    version: Literal["live", "draft"] | _QueryParam | None = ...,
) -> HttpResponseRedirect: ...
def get_page(
    request: HttpRequest,
    page_id: int,
    version: Literal["live", "draft"] | _QueryParam | None = ...,
    rich_text_format: RichTextOutputFormat | _QueryParam | None = ...,
) -> AbstractPage: ...
def create_page(
    request: HttpRequest,
    data: BaseModel | _BodyParam = ...,
    rich_text_format: RichTextOutputFormat | _QueryParam | None = ...,
) -> Status[AbstractPage]: ...
def update_page(
    request: HttpRequest,
    page_id: int,
    data: BaseModel | _BodyParam = ...,
    rich_text_format: RichTextOutputFormat | _QueryParam | None = ...,
) -> AbstractPage: ...
def list_page_revisions(
    request: HttpRequest,
    page_id: int,
    filters: RevisionFilterSchema | _QueryParam = ...,
    **kwargs: Any,
) -> dict[str, Any]: ...
def get_page_revision(request: HttpRequest, page_id: int, revision_id: int) -> Revision: ...
def publish(request: HttpRequest, page_id: int) -> AbstractPage: ...

class PageUnpublishSchema(Schema):
    recursive: bool = ...

def unpublish(request: HttpRequest, page_id: int, data: PageUnpublishSchema | _BodyParam = ...) -> AbstractPage: ...

class PageCopySchema(Schema):
    destination_id: int | None = ...
    recursive: bool = ...
    keep_live: bool = ...
    slug: str | None = ...
    title: str | None = ...
    @classmethod
    def validate_slug(cls, value: str | None) -> str | None: ...
    def get_destination(self) -> AbstractPage | None: ...
    def get_update_attrs(self, page: AbstractPage, destination: AbstractPage | None) -> dict[str, str]: ...

def copy(request: HttpRequest, page_id: int, data: PageCopySchema | _BodyParam = ...) -> Status[AbstractPage]: ...

PagePositionLiteral: TypeAlias = Literal[  # NOQA:UP040
    "first-child", "last-child", "left", "right", "first-sibling", "last-sibling"
]

class PageMoveSchema(Schema):
    destination_id: int
    position: PagePositionLiteral | None = ...

def move(request: HttpRequest, page_id: int, data: PageMoveSchema | _BodyParam = ...) -> AbstractPage: ...
def delete(request: HttpRequest, page_id: int) -> Status[None]: ...

class PageRevertSchema(Schema):
    revision_id: int

def revert(request: HttpRequest, page_id: int, data: PageRevertSchema | _BodyParam = ...) -> AbstractPage: ...
def convert_alias(request: HttpRequest, page_id: int) -> AbstractPage: ...

class PageCreateAliasSchema(Schema):
    destination_id: int | None = ...
    recursive: bool = ...
    slug: str | None = ...
    @classmethod
    def validate_slug(cls, value: str | None) -> str | None: ...
    def get_destination(self) -> AbstractPage | None: ...
    def get_update_slug(self, page: AbstractPage, destination: AbstractPage | None) -> str: ...

def create_alias(
    request: HttpRequest, page_id: int, data: PageCreateAliasSchema | _BodyParam = ...
) -> Status[AbstractPage]: ...

class PageCopyForTranslationSchema(Schema):
    locale: str
    copy_parents: bool = ...
    alias: bool = ...
    recursive: bool = ...

def copy_for_translation(
    request: HttpRequest, page_id: int, data: PageCopyForTranslationSchema | _BodyParam = ...
) -> Status[AbstractPage]: ...
