from collections.abc import Iterable
from datetime import datetime
from typing import Any, ClassVar, Literal, Self

from django.db.models import Q, QuerySet
from django.http import HttpRequest, QueryDict
from ninja import FilterSchema, NinjaAPI, Schema
from ninja.params.models import Body, BodyModel
from ninja.types import DictStrAny
from pydantic import BaseModel
from wagtail.api.v3.pagination import WagtailLimitOffsetPagination
from wagtail.models import TranslatableMixin
from wagtail.search.backends.base import BaseSearchResults

def validate_type(data: dict[str, Any], meta_type: str) -> dict[str, Any]: ...

class TypeInjectingBodyModel(BodyModel):
    validate: ClassVar[bool]  # type: ignore[assignment]
    @classmethod
    def get_request_data(cls, request: HttpRequest, api: NinjaAPI, path_params: DictStrAny) -> DictStrAny | None: ...
    @classmethod
    def get_meta_type(cls, request: HttpRequest, api: NinjaAPI, path_params: DictStrAny) -> str: ...

class TypeInjectingBody(Body):  # type: ignore[misc]
    _model: type[TypeInjectingBodyModel]
    @classmethod
    def _param_source(cls) -> str: ...

class APIFieldFilterSchema(Schema):
    raw_params: QueryDict
    base_fields: list[str]
    ignore_fields: set[str] = ...
    @classmethod
    def with_exclude_schemas(
        cls, schemas: tuple[type[BaseModel], ...], *, raw_params: QueryDict, base_fields: list[str]
    ) -> Self: ...
    def get_validated_fields(self, queryset: QuerySet[Any]) -> list[str]: ...
    def filter_queryset[QS: QuerySet[Any]](self, queryset: QS) -> QS: ...

class OrderingSchema(Schema):
    order: Literal["random"] | list[str] = ...
    def order_queryset[QS: QuerySet[Any]](
        self,
        queryset: QS,
        pagination_info: WagtailLimitOffsetPagination.Input,
        base_fields: Iterable[str] = (),
    ) -> QS: ...

class SearchSchema(Schema):
    search: str | None = ...
    search_operator: Literal["and", "or"] | None = ...
    def validate_settings(self) -> Self: ...
    def search_queryset[QS: QuerySet[Any]](self, request: HttpRequest, queryset: QS) -> QS | BaseSearchResults: ...

def locale_filter_q(language_code: str) -> Q: ...
def translation_of_q(instance: TranslatableMixin, inclusive: bool = False) -> Q: ...

class TranslationFilterSchema(Schema):
    locale: str | None = ...
    translation_of: str | None = ...
    def _check_translatable(self, queryset: QuerySet[Any], loc: str) -> None: ...
    def filter_queryset[QS: QuerySet[Any]](self, queryset: QS) -> QS: ...

class RevisionFilterSchema(FilterSchema):
    created_at_from: datetime | None = ...
    created_at_to: datetime | None = ...
    user_id: int | str | None = ...
    approved_go_live_at_from: datetime | None = ...
    approved_go_live_at_to: datetime | None = ...
    object_str: str | None = ...
