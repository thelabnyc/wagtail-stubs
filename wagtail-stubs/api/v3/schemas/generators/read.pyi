from collections.abc import Callable
from typing import Any, TypeAlias

from django.db.models import ForeignKey, ForeignObjectRel, Model
from django.db.models.fields import Field
from ninja import Schema
from wagtail.api import APIField
from wagtail.api.v3.schemas.base import BaseSchema
from wagtail.fields import RichTextField

FieldSchema: TypeAlias = tuple[Any, Any, Callable[..., Any] | None]  # NOQA:UP040
FieldSchemaFunc: TypeAlias = Callable[[SchemaGenerator, Field[Any, Any]], FieldSchema]  # NOQA:UP040

class SchemaGenerator:
    field_schemas: dict[type[Field[Any, Any] | ForeignObjectRel], FieldSchemaFunc]
    def __init__(self) -> None: ...
    @staticmethod
    def _get_pk_names(model: type[Model]) -> list[str]: ...
    @staticmethod
    def _custom_serializer_schema(api_field: APIField) -> FieldSchema: ...
    def register_field_schema[F: Field[Any, Any] | ForeignObjectRel](
        self,
        field_class: type[F],
        func: Callable[[SchemaGenerator, F], FieldSchema],
    ) -> None: ...
    def get_reverse_related_schema(self, model: type[Model]) -> type[BaseSchema]: ...
    def get_foreign_key_schema(self, model: type[Model]) -> type[BaseSchema]: ...
    def extend_schema[S: Schema](self, base: type[S], name: str, fields: dict[str, FieldSchema]) -> type[S]: ...
    def build_schema[S: Schema](
        self,
        model: type[Model],
        *,
        name: str,
        base_class: type[S],
        follow_reverse_related: bool,
    ) -> type[S]: ...
    def generate_schema[S: Schema](self, model: type[Model], base_class: type[S]) -> type[S]: ...
    @staticmethod
    def _narrowed_meta_schema[S: Schema](base_meta_schema: type[S], model: type[Model], *, name: str) -> type[S]: ...

def foreign_key_schema(generator: SchemaGenerator, field: ForeignKey[Any, Any]) -> FieldSchema: ...
def reverse_related_schema(generator: SchemaGenerator, field: ForeignObjectRel) -> FieldSchema: ...
def streamfield_schema(generator: SchemaGenerator, field: Field[Any, Any]) -> FieldSchema: ...
def tags_schema(generator: SchemaGenerator, field: Field[Any, Any]) -> FieldSchema: ...
def rich_text_schema(generator: SchemaGenerator, field: RichTextField) -> FieldSchema: ...

read_generator: SchemaGenerator
