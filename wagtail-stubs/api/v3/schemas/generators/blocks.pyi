from collections.abc import Callable, Iterable
from typing import Any, TypeAlias

from pydantic import GetJsonSchemaHandler, TypeAdapter
from pydantic.json_schema import JsonSchemaValue
from pydantic_core import CoreSchema
from wagtail.blocks import Block
from wagtail.fields import StreamField

# Schema functions return type forms built at runtime (TypedDicts, unions, Literals), which have no static type
BlockSchemaFunc: TypeAlias = Callable[[BlockSchemaBuilder, Block, str], Any]  # NOQA:UP040

class BlockSchemaBuilder:
    for_input: bool
    name_suffix: str
    representation_methods: list[str]
    block_schemas: dict[type[Block], BlockSchemaFunc]
    def __init__(self, *, for_input: bool) -> None: ...
    def register_block_schema[B: Block](
        self,
        block_class: type[B],
        func: Callable[[BlockSchemaBuilder, B, str], Any],
    ) -> None: ...
    def get_type(self, block: Block, name: str) -> Any: ...
    def get_typed_dict(self, name: str, fields: dict[str, Any]) -> type[Any]: ...
    def get_stream_type(self, items: Iterable[type[Any]]) -> Any: ...
    def get_stream_field_adapter(self, field: StreamField[Any]) -> TypeAdapter[Any]: ...

class StreamFieldJsonSchema:
    builder: BlockSchemaBuilder
    field: StreamField[Any]
    def __init__(self, builder: BlockSchemaBuilder, field: StreamField[Any]) -> None: ...
    def __get_pydantic_json_schema__(
        self, core_schema: CoreSchema, handler: GetJsonSchemaHandler
    ) -> JsonSchemaValue: ...

def stream_block_schema(builder: BlockSchemaBuilder, block: Block, name: str) -> Any: ...
def struct_block_schema(builder: BlockSchemaBuilder, block: Block, name: str) -> Any: ...
def list_block_schema(builder: BlockSchemaBuilder, block: Block, name: str) -> Any: ...
def choice_block_schema(builder: BlockSchemaBuilder, block: Block, name: str) -> Any: ...
def chooser_block_schema(builder: BlockSchemaBuilder, block: Block, name: str) -> Any: ...
def fixed_schema(value_type: Any) -> BlockSchemaFunc: ...
def register_default_block_schemas(builder: BlockSchemaBuilder) -> None: ...
