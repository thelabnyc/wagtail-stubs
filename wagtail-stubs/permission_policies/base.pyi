from collections.abc import Iterable
from typing import Any, Generic

from django.contrib.auth.models import AbstractBaseUser
from django.db.models import Model, QuerySet
from django.utils.functional import cached_property
from typing_extensions import TypeVar

_ModelT = TypeVar("_ModelT", bound=Model, default=Any)

class BasePermissionPolicy(Generic[_ModelT]):
    permission_cache_name: str

    def __init__(self, model: type[_ModelT] | str) -> None: ...
    @cached_property
    def model(self) -> type[_ModelT]: ...
    def check_model(self, model: type[Model]) -> None: ...
    def get_all_permissions_for_user(self, user: AbstractBaseUser) -> Iterable[Any]: ...
    def get_cached_permissions_for_user(self, user: AbstractBaseUser) -> Iterable[Any]: ...
    def user_has_permission(self, user: AbstractBaseUser, action: str) -> bool: ...
    def user_has_any_permission(self, user: AbstractBaseUser, actions: Iterable[str]) -> bool: ...
    def users_with_any_permission(self, actions: Iterable[str]) -> QuerySet[AbstractBaseUser]: ...
    def users_with_permission(self, action: str) -> QuerySet[AbstractBaseUser]: ...
    def user_has_permission_for_instance(self, user: AbstractBaseUser, action: str, instance: _ModelT) -> bool: ...
    def user_has_any_permission_for_instance(
        self, user: AbstractBaseUser, actions: Iterable[str], instance: _ModelT
    ) -> bool: ...
    def instances_user_has_any_permission_for(
        self, user: AbstractBaseUser, actions: Iterable[str]
    ) -> QuerySet[_ModelT]: ...
    def instances_user_has_permission_for(self, user: AbstractBaseUser, action: str) -> QuerySet[_ModelT]: ...
    def users_with_any_permission_for_instance(
        self, actions: Iterable[str], instance: _ModelT
    ) -> QuerySet[AbstractBaseUser]: ...
    def users_with_permission_for_instance(self, action: str, instance: _ModelT) -> QuerySet[AbstractBaseUser]: ...

class BlanketPermissionPolicy(BasePermissionPolicy[_ModelT]):
    def user_has_permission(self, user: AbstractBaseUser, action: str) -> bool: ...
    def user_has_any_permission(self, user: AbstractBaseUser, actions: Iterable[str]) -> bool: ...
    def users_with_any_permission(self, actions: Iterable[str]) -> QuerySet[AbstractBaseUser]: ...
    def users_with_permission(self, action: str) -> QuerySet[AbstractBaseUser]: ...

class AuthenticationOnlyPermissionPolicy(BasePermissionPolicy[_ModelT]):
    def user_has_permission(self, user: AbstractBaseUser, action: str) -> bool: ...
    def user_has_any_permission(self, user: AbstractBaseUser, actions: Iterable[str]) -> bool: ...
    def users_with_any_permission(self, actions: Iterable[str]) -> QuerySet[AbstractBaseUser]: ...
    def users_with_permission(self, action: str) -> QuerySet[AbstractBaseUser]: ...

class BaseDjangoAuthPermissionPolicy(BasePermissionPolicy[_ModelT]):
    def __init__(self, model: type[_ModelT] | str, auth_model: type[Model] | str | None = None) -> None: ...
    @cached_property
    def auth_model(self) -> type[Model]: ...
    @cached_property
    def app_label(self) -> str: ...
    @cached_property
    def model_name(self) -> str: ...

class ModelPermissionPolicy(BaseDjangoAuthPermissionPolicy[_ModelT]):
    def user_has_permission(self, user: AbstractBaseUser, action: str) -> bool: ...
    def users_with_any_permission(self, actions: Iterable[str]) -> QuerySet[AbstractBaseUser]: ...

class OwnershipPermissionPolicy(BaseDjangoAuthPermissionPolicy[_ModelT]):
    owner_field_name: str

    def __init__(
        self,
        model: type[_ModelT] | str,
        auth_model: type[Model] | str | None = None,
        owner_field_name: str = "owner",
    ) -> None: ...
    def check_model(self, model: type[Model]) -> None: ...
    def user_has_permission(self, user: AbstractBaseUser, action: str) -> bool: ...
    def users_with_any_permission(self, actions: Iterable[str]) -> QuerySet[AbstractBaseUser]: ...
    def user_has_permission_for_instance(self, user: AbstractBaseUser, action: str, instance: _ModelT) -> bool: ...
    def user_has_any_permission_for_instance(
        self, user: AbstractBaseUser, actions: Iterable[str], instance: _ModelT
    ) -> bool: ...
    def instances_user_has_any_permission_for(
        self, user: AbstractBaseUser, actions: Iterable[str]
    ) -> QuerySet[_ModelT]: ...
    def users_with_any_permission_for_instance(
        self, actions: Iterable[str], instance: _ModelT
    ) -> QuerySet[AbstractBaseUser]: ...
