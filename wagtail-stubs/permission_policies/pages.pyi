from collections.abc import Iterable
from typing import Any, overload

from django.contrib.auth.models import AbstractBaseUser
from django.db.models import QuerySet
from typing_extensions import TypeVar
from wagtail.models.pages import AbstractPage, GroupPagePermission, PageQuerySet
from wagtail.permission_policies.base import OwnershipPermissionPolicy

_PageT = TypeVar("_PageT", bound=AbstractPage, default=Any)

class PagePermissionPolicy(OwnershipPermissionPolicy[_PageT]):
    permission_cache_name: str

    @overload
    def __init__(self: PagePermissionPolicy[AbstractPage], model: None = None) -> None: ...
    @overload
    def __init__(self, model: type[_PageT] | str) -> None: ...
    @classmethod
    def for_model[P: AbstractPage](cls, model: type[P]) -> PagePermissionPolicy[P]: ...
    def get_all_permissions_for_user(self, user: AbstractBaseUser) -> QuerySet[GroupPagePermission]: ...
    def user_has_permission(self, user: AbstractBaseUser, action: str) -> bool: ...
    def user_has_any_permission(self, user: AbstractBaseUser, actions: Iterable[str]) -> bool: ...
    def users_with_any_permission(
        self, actions: Iterable[str], include_superusers: bool = True
    ) -> QuerySet[AbstractBaseUser]: ...
    def users_with_permission(self, action: str, include_superusers: bool = True) -> QuerySet[AbstractBaseUser]: ...
    def user_has_permission_for_instance(self, user: AbstractBaseUser, action: str, instance: _PageT) -> bool: ...
    def user_has_any_permission_for_instance(
        self, user: AbstractBaseUser, actions: Iterable[str], instance: _PageT
    ) -> bool: ...
    def instances_user_has_any_permission_for(
        self, user: AbstractBaseUser, actions: Iterable[str]
    ) -> PageQuerySet[_PageT]: ...
    def instances_user_has_permission_for(self, user: AbstractBaseUser, action: str) -> PageQuerySet[_PageT]: ...
    def users_with_any_permission_for_instance(
        self, actions: Iterable[str], instance: _PageT, include_superusers: bool = True
    ) -> QuerySet[AbstractBaseUser]: ...
    def users_with_permission_for_instance(
        self, action: str, instance: _PageT, include_superusers: bool = True
    ) -> QuerySet[AbstractBaseUser]: ...
    def instances_with_direct_explore_permission(
        self, user: AbstractBaseUser
    ) -> PageQuerySet[AbstractPage] | list[AbstractPage]: ...
    def explorable_root_instance(self, user: AbstractBaseUser) -> AbstractPage | None: ...
    def explorable_instances(self, user: AbstractBaseUser) -> PageQuerySet[_PageT]: ...
