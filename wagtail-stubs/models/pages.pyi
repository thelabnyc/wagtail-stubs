    def get_site(self) -> Site | None: ...
    def get_indexed_instance(self) -> Page | None: ...
    def get_default_privacy_setting(self, request: HttpRequest) -> dict[str, str]: ...
    def can_move_to(self, parent: Page) -> bool: ...
    def permissions_for_user(self, user: AbstractBaseUser) -> PagePermissionTester: ...
    def is_previewable(self) -> bool: ...
    def get_route_paths(self) -> list[str]: ...
    def get_cached_paths(self) -> list[str]: ...
    def get_cache_key_components(self) -> list[Any]: ...
    @property
    def cache_key(self) -> str: ...
    def get_sitemap_urls(self, request: HttpRequest | None = None) -> Sequence[dict[str, Any]]: ...
    def get_ancestors(self, inclusive: bool = False) -> PageQuerySet: ...
    def get_descendants(self, inclusive: bool = False) -> PageQuerySet: ...
    def get_siblings(self, inclusive: bool = True) -> PageQuerySet: ...
    def get_next_siblings(self, inclusive: bool = False) -> PageQuerySet: ...
    def get_prev_siblings(self, inclusive: bool = False) -> PageQuerySet: ...
    def get_children(self) -> PageQuerySet: ...
    def get_view_restrictions(
        self,
    ) -> models.QuerySet[PageViewRestriction]: ...
    def serve_password_required_response(self, request: HttpRequest, form: Any, action_url: str) -> HttpResponse: ...
    def with_content_json(self, content: dict[str, Any]) -> Page: ...
    @property
    def has_workflow(self) -> bool: ...
    def get_workflow(self) -> Workflow | None: ...
    @property
    def approved_schedule(self) -> bool: ...
    def has_unpublished_subtree(self) -> bool: ...
    def move(
        self,
        target: Page,
        pos: str | None = None,
        user: AbstractBaseUser | None = None,
    ) -> None: ...
    def copy(
        self,
        recursive: bool = False,
        to: Page | None = None,
        update_attrs: dict[str, Any] | None = None,
        copy_revisions: bool = True,
        keep_live: bool = True,
