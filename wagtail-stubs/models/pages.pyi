PAGE_PERMISSION_CODENAMES: list[str]

def get_page_models() -> list[type[Page]]: ...
def get_page_content_types(include_base_page_type: bool = True) -> models.QuerySet[ContentType]: ...
def get_streamfield_names(model_class: type[Page]) -> tuple[str, ...]: ...
