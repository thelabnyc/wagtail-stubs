    def get_preview_context(self, request: HttpRequest, mode_name: str) -> dict[str, Any]: ...
    def get_template(self, request: HttpRequest, *args: Any, **kwargs: Any) -> _TemplateForResponseT: ...
    def get_preview_template(self, request: HttpRequest, mode_name: str) -> _TemplateForResponseT: ...
    def serve(self, request: HttpRequest, *args: Any, **kwargs: Any) -> HttpResponse: ...
    def check_request_method(self, request: HttpRequest, *args: Any, **kwargs: Any) -> HttpResponse | None: ...
    def handle_options_request(self, request: HttpRequest, *args: Any, **kwargs: Any) -> HttpResponse: ...
    def is_navigable(self) -> bool: ...
    def get_url_parts(
        self, request: HttpRequest | None = None
    ) -> tuple[int, str, str] | tuple[int, None, None] | None: ...
    def get_full_url(self, request: HttpRequest | None = None) -> str | None: ...
    @property
    def full_url(self) -> str | None: ...
    def get_url(
        self,
