# ---------------------------------------------------------------------------
# Query classes (defined here to avoid circular import with wagtail.query)
# Re-exported via wagtail.query for public API compatibility.
# ---------------------------------------------------------------------------

class TreeQuerySet[T: MP_Node](MP_NodeQuerySet[T]):
    def descendant_of_q(self, other: MP_Node, inclusive: bool = False) -> Q: ...
    def descendant_of(self, other: MP_Node, inclusive: bool = False) -> Self: ...
    def not_descendant_of(self, other: MP_Node, inclusive: bool = False) -> Self: ...
    def child_of_q(self, other: MP_Node) -> Q: ...
    def child_of(self, other: MP_Node) -> Self: ...
    def not_child_of(self, other: MP_Node) -> Self: ...
    def ancestor_of_q(self, other: MP_Node, inclusive: bool = False) -> Q: ...
    def ancestor_of(self, other: MP_Node, inclusive: bool = False) -> Self: ...
    def not_ancestor_of(self, other: MP_Node, inclusive: bool = False) -> Self: ...
    def parent_of_q(self, other: MP_Node) -> Q: ...
    def parent_of(self, other: MP_Node) -> Self: ...
    def not_parent_of(self, other: MP_Node) -> Self: ...
    def sibling_of_q(self, other: MP_Node, inclusive: bool = True) -> Q: ...
    def sibling_of(self, other: MP_Node, inclusive: bool = True) -> Self: ...
    def not_sibling_of(self, other: MP_Node, inclusive: bool = True) -> Self: ...

class PageQuerySet[T: MP_Node](SearchableQuerySetMixin, SpecificQuerySetMixin, TreeQuerySet[T]):
    def __iter__(self) -> Iterator[T]: ...
    def live_q(self) -> Q: ...
    def live(self) -> Self: ...
    def not_live(self) -> Self: ...
    def in_menu_q(self) -> Q: ...
    def in_menu(self) -> Self: ...
    def not_in_menu(self) -> Self: ...
    def page_q(self, other: Page) -> Q: ...
    def page(self, other: Page) -> Self: ...
    def not_page(self, other: Page) -> Self: ...
    def type_q(self, *types: type) -> Q: ...
    def type(self, *types: type) -> Self: ...
    def not_type(self, *types: type) -> Self: ...
    def exact_type_q(self, *types: type) -> Q: ...
    def exact_type(self, *types: type) -> Self: ...
    def not_exact_type(self, *types: type) -> Self: ...
    def private_q(self) -> Q: ...
    def public(self) -> Self: ...
    def not_public(self) -> Self: ...
    def private(self) -> Self: ...
    def first_common_ancestor(self, include_self: bool = False, strict: bool = False) -> T: ...
    def unpublish(self) -> None: ...
    def defer_streamfields(self) -> Self: ...
    def in_site(self, site: Site) -> Self: ...
    def translation_of_q(self, page: Page, inclusive: bool) -> Q: ...
    def translation_of(self, page: Page, inclusive: bool = False) -> Self: ...
    def not_translation_of(self, page: Page, inclusive: bool = False) -> Self: ...
    def prefetch_workflow_states(self) -> Self: ...
    def annotate_approved_schedule(self) -> Self: ...
    def annotate_site_root_state(self) -> Self: ...
    def annotate_has_untranslated_locale(self) -> Self: ...

class SpecificIterable(ModelIterable):
    def __iter__(self) -> Iterator[Page]: ...

class DeferredSpecificIterable(ModelIterable):
    def __iter__(self) -> Iterator[Page]: ...

def get_page_models() -> list[type[Page]]: ...
def get_page_content_types(
    include_base_page_type: bool = True,
) -> models.QuerySet[ContentType]: ...
def get_streamfield_names(model_class: type[Page]) -> tuple[str, ...]: ...
def reassign_root_page_locale_on_delete(sender: type, instance: Locale, **kwargs: Any) -> None: ...

class BasePageManager[PM: MP_Node](models.Manager[PM]):
    def get_queryset(self) -> PageQuerySet[PM]: ...
    def first_common_ancestor_of(
        self,
        pages: Sequence[Page],
        include_self: bool = False,
        strict: bool = False,
    ) -> Page: ...
    def annotate_parent_page(self, pages: Sequence[Page]) -> None: ...

PageManager = BasePageManager.from_queryset(PageQuerySet)

class PageBase(models.base.ModelBase):
    def __init__(cls, name: str, bases: tuple[type, ...], dct: dict[str, Any]) -> None: ...

class AbstractPage(
    WorkflowMixin,
    PreviewableMixin,
    DraftStateMixin,
    LockableMixin,
    RevisionMixin,
    TranslatableMixin,
    SpecificMixin,
    MP_Node,
):
    objects: PageManager  # type: ignore[assignment]
    class Meta:
        abstract: bool

class Page(AbstractPage, index.Indexed, ClusterableModel, metaclass=PageBase):
    # ---- model fields ----
    id: int
    title: models.CharField[str, str]
    draft_title: models.CharField[str, str]
    slug: models.SlugField[str, str]
    content_type: models.ForeignKey[ContentType, ContentType]
    url_path: models.TextField[str, str]
    owner: models.ForeignKey[AbstractBaseUser | None, AbstractBaseUser | None]
    seo_title: models.CharField[str, str]
    show_in_menus: models.BooleanField[bool | int, bool]
    search_description: models.TextField[str, str]
    latest_revision_created_at: models.DateTimeField[datetime.datetime | None, datetime.datetime | None]
    alias_of: models.ForeignKey[Page | None, Page | None]
    _default_manager: PageManager  # type: ignore[assignment]

    # ---- class-level configuration ----
    search_fields: list[index.BaseField | index.RelatedFields]
    is_creatable: bool
    max_count: int | None
    max_count_per_parent: int | None
    admin_default_ordering: str
    exclude_fields_in_copy: list[str]
    default_exclude_fields_in_copy: list[str]
    content_panels: list[Any]
    promote_panels: list[Any]
    settings_panels: list[Any]
    template: str
    ajax_template: str | None
    show_in_menus_default: bool
    private_page_options: list[str]
    context_object_name: str | None
    password_required_template: str | None
    subpage_types: Sequence[str | type[Page]] | None
    parent_page_types: Sequence[str | type[Page]] | None
    allowed_http_methods: list[HTTPMethod]

    objects: PageManager  # type: ignore[assignment]

    # ---- static / class methods ----
    @staticmethod
    def route_for_request(request: HttpRequest, path: str) -> RouteResult | None: ...
    @staticmethod
    def find_for_request(request: HttpRequest, path: str) -> Page | None: ...
    @classmethod
    def allowed_http_method_names(cls) -> list[str]: ...
    @classmethod
    def check(cls, **kwargs: Any) -> list[CheckMessage]: ...
    @classmethod
    def get_streamfield_names(cls) -> tuple[str, ...]: ...
    @classmethod
    def get_indexed_objects(cls) -> models.QuerySet[Page]: ...
    @classmethod
    def clean_subpage_models(cls) -> list[type[Page]]: ...
    @classmethod
    def clean_parent_page_models(cls) -> list[type[Page]]: ...
    @classmethod
    def allowed_parent_page_models(cls) -> list[type[Page]]: ...
    @classmethod
    def allowed_subpage_models(cls) -> list[type[Page]]: ...
    @classmethod
    def creatable_subpage_models(cls) -> list[type[Page]]: ...
    @classmethod
    def can_exist_under(cls, parent: Page) -> bool: ...
    @classmethod
    def can_create_at(cls, parent: Page) -> bool: ...
    @classmethod
    def get_verbose_name(cls) -> str: ...
    @classmethod
    def get_page_description(cls) -> str: ...

    # ---- instance methods ----
    def __init__(self, *args: Any, **kwargs: Any) -> None: ...
    @property
    def revisions(self) -> models.QuerySet[Revision]: ...
    def get_base_content_type(self) -> ContentType: ...
    def get_content_type(self) -> ContentType: ...
    def set_url_path(self, parent: Page | None) -> str: ...
    def full_clean(self, *args: Any, **kwargs: Any) -> None: ...
    def clean(self) -> None: ...
    def minimal_clean(self) -> None: ...
    def get_default_locale(self) -> Locale: ...
    def get_admin_default_ordering(self) -> str: ...
    def is_site_root(self) -> bool: ...
    def save(  # type: ignore[override]
        self,
        clean: bool = True,
        user: AbstractBaseUser | None = None,
        log_action: bool | str | None = False,
        **kwargs: Any,
    ) -> None: ...
    def delete(self, *args: Any, **kwargs: Any) -> tuple[int, dict[str, int]]: ...
    @property
    def page_type_display_name(self) -> str: ...
    def route(self, request: HttpRequest, path_components: list[str]) -> RouteResult: ...
    def get_admin_display_title(self) -> str: ...
    def save_revision(
        self,
        user: AbstractBaseUser | None = None,
        approved_go_live_at: datetime.datetime | None = None,
        changed: bool = True,
        log_action: bool | str = False,
        previous_revision: Revision | None = None,
        clean: bool = True,
        overwrite_revision: Revision | None = None,
    ) -> Revision: ...
    def get_latest_revision_as_object(self) -> Page: ...
    def update_aliases(
        self,
        *,
        revision: Revision | None = None,
        _content: dict[str, Any] | None = None,
        _updated_ids: list[int] | None = None,
    ) -> None: ...
    def publish(
