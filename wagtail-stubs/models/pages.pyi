        alias: bool = False,
        exclude_fields: list[str] | None = None,
    ) -> Page: ...
    def get_parent(self, update: bool = False) -> Page | None: ...
    def get_translations(self, inclusive: bool = False) -> PageQuerySet: ...

    class Meta:
        verbose_name: str
        verbose_name_plural: str
        unique_together: list[tuple[str, str]]
        permissions: list[tuple[str, str]]

class GroupPagePermissionManager(models.Manager["GroupPagePermission"]):
