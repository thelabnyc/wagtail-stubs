from typing import Any

from ninja import Schema
from wagtail.api.v3.schemas.base import BaseMetaSchema, BaseSchema
from wagtail.images.models import AbstractImage

Image: type[AbstractImage]
BASE_IMAGE_FIELDS: list[str]

class CollectionForeignKeySchema(BaseSchema):
    id: int

class ImageMetaSchema(BaseMetaSchema):
    detail_url: str | None = ...
    tags: list[str] = ...
    download_url: str | None = ...
    @staticmethod
    def resolve_detail_url(obj: AbstractImage, context: dict[str, Any]) -> str | None: ...
    @staticmethod
    def resolve_tags(obj: AbstractImage) -> list[str]: ...
    @staticmethod
    def resolve_download_url(obj: AbstractImage) -> str | None: ...

class ImageSchema(BaseSchema):
    id: int
    title: str
    width: int
    height: int
    description: str | None = ...
    collection: CollectionForeignKeySchema
    focal_point_x: int | None = ...
    focal_point_y: int | None = ...
    focal_point_width: int | None = ...
    focal_point_height: int | None = ...
    meta: ImageMetaSchema

def _narrowed_image_meta_schema() -> type[ImageMetaSchema]: ...
def build_image_schemas() -> tuple[type[ImageSchema], type[Schema], type[Schema]]: ...
