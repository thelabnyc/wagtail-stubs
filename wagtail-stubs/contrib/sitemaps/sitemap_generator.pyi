from collections.abc import Iterable, Iterator, Mapping, Sequence
from typing import Any
import datetime

from django.contrib.sitemaps import Sitemap as DjangoSitemap
from django.http import HttpRequest
from typing_extensions import TypeVar
from wagtail.models import AbstractPage, PageQuerySet, Site

_PageT = TypeVar("_PageT", bound=AbstractPage, default=Any)

class Sitemap(DjangoSitemap[_PageT]):
    chunk_size: int
    request: HttpRequest | None
    alternates: bool
    def __init__(self, request: HttpRequest | None = None, alternates: bool = False) -> None: ...
    def location(self, obj: _PageT) -> str | None: ...  # type: ignore[override]
    def lastmod(self, obj: _PageT) -> datetime.datetime | None: ...
    def get_wagtail_site(self) -> Site: ...
    def items(self) -> Iterable[_PageT]: ...
    def get_translations(self, page_instances: Sequence[AbstractPage]) -> PageQuerySet[AbstractPage] | None: ...
    def prefetch_translated_objects(self, page_instances: Sequence[AbstractPage]) -> None: ...
    def translated_iterator[T: AbstractPage](self, iterator: Iterator[T]) -> Iterator[T]: ...
    def _urls(self, page: int, protocol: str, domain: str) -> Sequence[Mapping[str, Any]]: ...
