from collections.abc import Mapping
from typing import Any, Literal, TypeAlias

from django.contrib.auth.base_user import AbstractBaseUser
from django.db.models import Model
from typing_extensions import TypeVar
from wagtail.actions.base import BaseAction
from wagtail.models.workflows import TaskState, WorkflowMixin, WorkflowState

_TargetT = TypeVar("_TargetT", bound=WorkflowMixin | TaskState, default=Any)
_WorkflowT = TypeVar("_WorkflowT", bound=WorkflowMixin, default=Any)
_WorkflowTransition: TypeAlias = Literal["submit", "approve", "reject", "resume", "cancel"]  # NOQA:UP040

class WorkflowStateError(Exception): ...

def can_edit_instance(instance: Model, user: AbstractBaseUser) -> bool: ...

class WorkflowAction(BaseAction[_TargetT]):
    def user_has_permission(self) -> bool: ...
    def check_lock(self) -> None: ...
    def check(self, skip_permission_checks: bool = False) -> None: ...
    def can_execute(self) -> bool: ...

class SubmitWorkflowAction(WorkflowAction[_WorkflowT]):
    def check(self, skip_permission_checks: bool = False) -> None: ...
    def execute(self, skip_permission_checks: bool = False) -> WorkflowState: ...

class ResumeWorkflowAction(WorkflowAction[_WorkflowT]):
    def check(self, skip_permission_checks: bool = False) -> None: ...
    def execute(self, skip_permission_checks: bool = False) -> WorkflowState: ...

class ApproveTaskStateAction(WorkflowAction[TaskState]):
    task_action_name: str
    task_state: TaskState
    data: Mapping[str, Any]
    object: Model
    def __init__(
        self,
        task_state: TaskState,
        user: AbstractBaseUser | None = None,
        data: Mapping[str, Any] | None = None,
    ) -> None: ...
    def check(self, skip_permission_checks: bool = False) -> None: ...
    def get_form_cleaned_data(self) -> dict[str, Any]: ...
    def execute(self, skip_permission_checks: bool = False) -> TaskState: ...

class RejectTaskStateAction(ApproveTaskStateAction): ...

class CancelWorkflowAction(WorkflowAction[_WorkflowT]):
    def check(self, skip_permission_checks: bool = False) -> None: ...
    def execute(self, skip_permission_checks: bool = False) -> WorkflowState: ...

def get_available_workflow_transitions(
    instance: WorkflowMixin, user: AbstractBaseUser | None = None
) -> list[_WorkflowTransition]: ...
